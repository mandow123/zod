{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vite/client"]
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "worker/**/*.ts", "../src/**/*.ts", "../src/**/*.tsx", "../demo-api.d.mts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "../src/test"]
}
