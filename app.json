{
  "expo": {
    "name": "Zod",
    "slug": "kai-cloudpay",
    "description": "面向企业算力任务的原生市场、容量发布与履约状态应用。",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kaicloudpay",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F5F8",
    "primaryColor": "#1677FF",
    "plugins": [
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-android-release-signing",
      [
        "expo-notifications",
        {
          "color": "#1677FF",
          "defaultChannel": "cloudpay-activity"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaicloud.marketplace",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.kaicloud.marketplace",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cloud.kai.com",
              "path": "/zod/oauth2redirect/kai"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "android.permission.READ_APP_BADGE",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F2F5F8",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "cloudPayBaseUrl": "https://cloudpay.kai.com",
      "kaiOidcIssuer": "https://auth.kai.com/api/auth",
      "kaiOidcClientId": "xUTgWjuzpAz-JT-wDbTJxh9xoh3ssU7K",
      "kaiAuthAppRedirect": "https://cloud.kai.com/zod/oauth2redirect/kai",
      "accountDeletionUrl": "https://cloudpay.kai.com/account/delete",
      "distributionChannel": "direct-cn",
      "nativeTopupsEnabled": true,
      "newOrdersEnabled": true
    }
  }
}
