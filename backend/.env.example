NODE_ENV=development
# 生产必须显式选择。inquiry_only 只开放统一身份、法务、正式供应商目录和买家询期；
# full_commerce 保留完整商城门禁，不能由 inquiry_only 自动降级或推断。
MOBILE_API_PROFILE=full_commerce
HOST=127.0.0.1
PORT=4100
PUBLIC_ORIGIN=http://127.0.0.1:4100
DATABASE_URL=postgresql://cloudpay:change-me@127.0.0.1:5432/cloudpay
DATABASE_SSL=false
# 直接对外监听保持 0；位于固定层数反向代理后填写实际层数，避免伪造客户端 IP。
TRUST_PROXY_HOPS=0

# 新交易模型门禁。卡时账本、充值验证、资源审核和订单扣款全部完成前，即使设为 true 也不会开放交易。

# 生产共享账号安全密钥。正式环境不读取、不要求旧 HS256/refresh/OTP 密钥；
# 那三项仅由 NODE_ENV=test + LOCAL_E2E=true 的隔离验收进程在自身环境中提供。
PII_ENCRYPTION_KEY=
AUDIT_PEPPER=
CURSOR_SECRET=

# 旧 CloudPay broker（仅兼容非生产环境）。正式 App 登录不依赖这些配置。
KAI_OIDC_CLIENT_ID=
KAI_OIDC_CLIENT_SECRET=
# 短期 state/nonce/App code 可轮换 pepper；不得与下面长期身份映射 pepper 共用。
KAI_OIDC_FLOW_PEPPER=
# issuer+sub 的长期稳定映射键。轮换前必须先完成数据库哈希迁移，否则会产生第二个本地账户。
KAI_OIDC_SUBJECT_PEPPER=
# 独立随机 32 字节 Base64，只加密五分钟 OIDC 事务里的后端 PKCE verifier。
KAI_OIDC_TRANSACTION_ENCRYPTION_KEY=
# 逗号分隔精确白名单；当前正式 App 只允许这一项。
KAI_OIDC_APP_REDIRECT_URIS=kaicloudpay://auth/kai/callback

# KAI Cloud 服务端公共接口。留空即 fail-closed；不得填写网站 Cookie、管理员会话或 Host Agent 私钥。
KAI_CLOUD_PUBLIC_API_URL=
KAI_CLOUD_PUBLIC_TOKEN_URL=
KAI_CLOUD_PUBLIC_CLIENT_ID=
KAI_CLOUD_PUBLIC_CLIENT_SECRET=
KAI_CLOUD_PUBLIC_WEBHOOK_SECRET=

# Seedance 视频能力默认关闭；关闭时不注册路由、不实例化服务或访问外部提供方。
SEEDANCE_VIDEO_ENABLED=false
AI_API_KEY=
AI_API_BASE_URL=https://gw.aiapiway.com/v1

# 管理员认证默认关闭。只有下列配置完整、通过 readiness 后才可显式开启。
# 管理员 OIDC client、回调、Group 白名单和所有密钥必须与移动端/全局配置独立。
ADMIN_AUTH_ENABLED=false
ADMIN_WEB_ORIGIN=
# 管理员 API 必须使用独立 origin；不得与移动/public API 或管理员 Web origin 复用。
ADMIN_API_ORIGIN=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
# 必须是 HTTPS，且路径精确为 /admin/v1/auth/callback。
ADMIN_OIDC_REDIRECT_URI=
# 必须包含 openid，禁止 offline_access；Group scope 由 auth.kai.com 管理客户端合约确定。
ADMIN_OIDC_SCOPE=
# 首选 Group claim 与 Group -> ADMIN_ROLE_CODES 的精确 JSON 白名单。
# 若 IdP 不支持专用 Group claim，可显式使用 email + email scope；此时映射键只能是
# 已验证、全小写的完整邮箱，不支持域名/通配符。示例文件仍不得写入真实邮箱或 Claim。
ADMIN_OIDC_GROUP_CLAIM=
ADMIN_OIDC_GROUP_ROLE_MAPPING_JSON=
# 下列 Pepper 至少 32 字符，必须彼此独立，也不得复用移动端或全局密钥。
ADMIN_OIDC_FLOW_PEPPER=
ADMIN_OIDC_SUBJECT_PEPPER=
ADMIN_OIDC_GROUP_PEPPER=
ADMIN_SESSION_TOKEN_PEPPER=
ADMIN_CSRF_TOKEN_PEPPER=
ADMIN_AUDIT_PEPPER=
# 两项均为各自独立的随机 32 字节规范 Base64 密钥。
ADMIN_OIDC_TRANSACTION_ENCRYPTION_KEY=
ADMIN_PII_ENCRYPTION_KEY=
# 默认：登录事务 5 分钟，Session 空闲 30 分钟/绝对 8 小时，15 分钟轮换，旧 Token 最多宽限 30 秒。
ADMIN_LOGIN_TRANSACTION_TTL_SECONDS=300
ADMIN_SESSION_IDLE_TTL_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=28800
ADMIN_SESSION_ROTATION_SECONDS=900
ADMIN_SESSION_PREVIOUS_TOKEN_GRACE_SECONDS=30
ADMIN_REAUTH_FRESHNESS_SECONDS=300

# Zod 正式 App 直接使用 auth.kai.com 公共 client + PKCE；APK 中没有 secret。
# issuer/client_id/redirect URI 是代码内固定公开元数据。资源 API 要求 opaque access token 与
# X-KAI-ID-Token 成对出现；后端验证 ID token 的 EdDSA/iss/aud/exp/at_hash，并实时 userinfo 验活及比对 sub。
# ID token 不得单独授权或放入 Bearer。两个 token 不得写入日志。
KAI_RESOURCE_ACCESS_TOKEN_FORMAT=opaque
# 以下两项仅供未来 auth 明确签发 JWT access token 时使用；当前 opaque 契约留空。
KAI_RESOURCE_ACCESS_TOKEN_AUDIENCE=
KAI_RESOURCE_ACCESS_TOKEN_REQUIRED_SCOPE=

# 外部服务。缺失时对应能力会关闭，不会伪造成功。
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
TOPUP_ALIPAY_NOTIFY_URL=https://cloudpay.kai.com/mobile/v1/credits/topups/alipay/notify
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_MERCHANT_CERT_SERIAL=
WECHAT_PLATFORM_CERT_SERIAL=
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
TOPUP_WECHAT_NOTIFY_URL=https://cloudpay.kai.com/mobile/v1/credits/topups/wechat/notify
WECHAT_PLATFORM_CERTIFICATE=

# 七相真实充值。默认 off；shadow 不注册支付路由。on 仅在独立 0600 凭据、十项双人审批证据、
# 单写账本、回调与主动查单任务全部通过时开放。密钥只放在 CREDENTIALS_DIRECTORY，禁止写入本文件。
QIXIANG_TOPUP_MODE=off
QIXIANG_RECOVERY_MODE=off
QIXIANG_PID=4611
QIXIANG_APPROVED_MAX_CENTS=
QIXIANG_CHECKOUT_KEY_ID=
QIXIANG_CHECKOUT_CIPHER_VERSION=1
QIXIANG_NOTIFY_URL=https://cloudpay.kai.com/mobile/v1/credits/topups/qixiang/notify
QIXIANG_RETURN_URL=https://cloudpay.kai.com/payments/qixiang/return
CREDENTIALS_DIRECTORY=
QIXIANG_KEY_ROTATION_EVIDENCE_REF=
QIXIANG_OLD_KEY_REVOCATION_EVIDENCE_REF=
QIXIANG_MERCHANT_ENTITY_EVIDENCE_REF=
QIXIANG_DOMAIN_APP_SCENE_EVIDENCE_REF=
QIXIANG_SERVICE_CATEGORY_EVIDENCE_REF=
QIXIANG_REFUND_API_EVIDENCE_REF=
QIXIANG_REAL_FULFILLMENT_EVIDENCE_REF=
QIXIANG_RECONCILIATION_EVIDENCE_REF=
QIXIANG_APPROVED_MAX_EVIDENCE_REF=
QIXIANG_LOT_ACCOUNTING_EVIDENCE_REF=
# Expo Push API；开启增强推送安全后填写项目 Access Token。
PUSH_PROVIDER=expo
PUSH_CREDENTIALS_JSON=
# 仅 full_commerce 的证据上传使用；inquiry_only 不实例化且不作为上线门禁。
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
CLAMAV_HOST=
CLAMAV_PORT=3310

# 算力履约只允许接入受控的 sidecar-v1。生产地址必须为私网 HTTPS；令牌由密钥系统注入，至少 32 个字符。
COMPUTE_PROVIDER=sidecar-v1
COMPUTE_PROVIDER_URL=https://h100-sidecar.internal:9443
COMPUTE_PROVIDER_TOKEN=
# 当前订单严格分配一张 GPU；不得改成整机 8 卡或其他数量。
COMPUTE_ALLOCATED_ACCELERATOR_COUNT=1
# 已验真实机为 8 张 H100；同一资源最多同时存在 8 个活跃的单卡租约。
COMPUTE_NODE_ACCELERATOR_COUNT=8
VAST_API_URL=https://console.vast.ai
VAST_API_KEY=
# Server-only policy. App responses expose only final two-decimal card-hours.
VAST_PRICING_POLICY_JSON=

# 0057 旧达人账本只允许显式 drain 收口；缺省 off，禁止新建链接、归因或发现订单。
LEGACY_CREATOR_COMMISSION_MODE=off
CREATOR_REFERRAL_SIGNING_SECRET=
CREATOR_COMMISSION_POLICY_JSON=

# 新主播与普通邀请是两个独立域。缺省 off；shadow 只做旁路资格/审计且不占全局订单归属。
# 本批未接订单原子归因和final-net生产者，因此on会被release门禁拒绝。两套签名密钥必须各自至少32字符且不能相同。
STREAMER_REWARDS_MODE=off
STREAMER_REFERRAL_SIGNING_SECRET=
STREAMER_REWARD_POLICY_JSON=
INVITE_REWARDS_MODE=off
INVITE_REFERRAL_SIGNING_SECRET=
INVITE_REWARD_POLICY_JSON=

# 上海鸿欢正式预约目录：off 不暴露；read_only 仅允许查看；inquiry 才允许提交询期。
# inquiry_only 生产配置必须显式为 inquiry，并通过0062、11项种子、平台公开指令、Logo源哈希和报价有效期门禁。
# full_commerce 可独立保持 off 或 read_only；不得从 profile 自动推断。
HONGHUAN_SUPPLIER_CATALOG_MODE=off

# 节点接入密钥必须彼此独立，也不得复用 PII/AUDIT/sidecar 令牌。加密密钥为随机 32 字节 Base64。
NODE_GPU_FINGERPRINT_PEPPER=
NODE_CLAIM_TOKEN_PEPPER=
NODE_CLAIM_TOKEN_ENCRYPTION_KEY=
# 逗号分隔；只有明确允许的 sidecar 版本才能把节点变为可交付。
NODE_SUPPORTED_AGENT_VERSIONS=1.0.0

# 监控系统抓取 /internal/metrics 使用，至少 32 个随机字符。
METRICS_BEARER_TOKEN=

# 数据库备份：inquiry_only 仅要求43机本地0600 AES-256-GCM文件；这不是异地灾备或高可用。
# BACKUP_S3_* 只属于 full_commerce 的异地对象锁备份，inquiry_only 可全部留空。
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=
BACKUP_LOCAL_DIRECTORY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_RETENTION_DAYS=35

# 上架与客服门禁。
LEGAL_ENTITY_NAME=
UNIFIED_SOCIAL_CREDIT_CODE=
SUPPORT_EMAIL=
SUPPORT_PHONE=
PRIVACY_POLICY_URL=
TERMS_URL=
INQUIRY_TERMS_URL=
ICP_FILING=
ICP_FILING_STATUS=
ICP_FILING_EVIDENCE_REF=
APP_FILING=
APP_FILING_STATUS=
APP_FILING_EVIDENCE_REF=
INTERNET_SERVICE_CLASSIFICATION_STATUS=
INTERNET_SERVICE_CLASSIFICATION_EVIDENCE_REF=
# 完整商业模式的主机预检额外绑定实际交易域名、Android 包名与同一运营主体；询期模式留空。
ICP_FILING_DOMAIN=
APP_FILING_PACKAGE=
FILING_OPERATOR_CREDIT_CODE=
