[Unit]
Description=KAI CloudPay mobile API private ALB ingress on port 4154
Requires=cloudpay-mobile-edge-firewall.service
After=cloudpay-mobile-edge-firewall.service

[Socket]
# Replace PRIVATE_IPV4 with this host's actual VPC IPv4 before installation.
ListenStream=PRIVATE_IPV4:4154
Accept=no

[Install]
WantedBy=sockets.target

