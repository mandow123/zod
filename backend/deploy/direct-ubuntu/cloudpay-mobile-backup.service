[Unit]
Description=KAI CloudPay local AES-256-GCM PostgreSQL backup
Wants=network-online.target
After=network-online.target cloudpay-mobile-backend.service

[Service]
Type=oneshot
User=kai-cloudpay
Group=kai-cloudpay
WorkingDirectory=/opt/kai-cloudpay/current
EnvironmentFile=/etc/kai-cloudpay/backend.env
ExecStart=/usr/bin/node dist/backups/backup.js
TimeoutStartSec=3300
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/kai-cloudpay-backup
