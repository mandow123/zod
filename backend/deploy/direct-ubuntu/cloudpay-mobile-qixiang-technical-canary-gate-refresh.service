[Unit]
Description=Refresh CloudPay Qixiang technical canary gate
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/kai-cloudpay/backend.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/kai-cloudpay/current
EnvironmentFile=/etc/kai-cloudpay/backend.env
UMask=0022
StateDirectory=kai-cloudpay-public-gates
StateDirectoryMode=0755
ExecStart=/usr/bin/node deploy/direct-ubuntu/issue-qixiang-technical-canary-gate.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/credstore.encrypted /etc/kai-cloudpay/backend.env
RestrictSUIDSGID=true
LockPersonality=true
