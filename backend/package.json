{
  "name": "@kai-cloudpay/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "e2e:resource": "tsx scripts/resource-evidence-e2e-server.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "contract:verify": "node ../scripts/verify-mobile-backend-contract.mjs",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts",
    "db:backup": "tsx src/backups/backup.ts",
    "db:backup:inspect": "tsx src/backups/inspect.ts",
    "db:fingerprint": "tsx src/backups/fingerprint.ts",
    "db:restore": "tsx src/backups/restore.ts",
    "release:bundle": "node scripts/build-deployment-bundle.mjs",
    "release:verify": "node scripts/verify-release.mjs --install",
    "deployment:verify": "node scripts/verify-deployment-contract.mjs",
    "catalog:import": "tsx scripts/import-supplier-catalog.ts",
    "data:export": "node dist/compute-data/export.js",
    "inquiry:acceptance": "tsx scripts/inquiry-acceptance-server.ts",
    "inquiry:acceptance:verify": "node scripts/verify-inquiry-acceptance.mjs",
    "staging:sandbox": "tsx staging-sandbox/server.ts",
    "staging:sandbox:verify": "node staging-sandbox/verify.mjs",
    "production:routing:capture": "node deploy/direct-ubuntu/verify-routing.mjs capture",
    "production:routing:verify": "node deploy/direct-ubuntu/verify-routing.mjs verify",
    "production:sidecar:preflight": "node deploy/direct-ubuntu/preflight-sidecar.mjs",
    "production:probe-static-credentials:provision": "node deploy/direct-ubuntu/provision-probe-static-credentials.mjs",
    "production:probe-static-credentials:verify": "node deploy/direct-ubuntu/verify-probe-static-credentials.mjs",
    "production:probe-refresh:authorize-enroll": "node scripts/authorize-and-enroll-kai-probe.mjs",
    "production:probe-refresh:enroll-host": "node deploy/direct-ubuntu/enroll-probe-refresh-credential.mjs",
    "production:qixiang-evidence:verify": "node deploy/direct-ubuntu/verify-qixiang-production-evidence.mjs",
    "production:qixiang-credentials:enroll-host": "node deploy/direct-ubuntu/enroll-qixiang-commerce-credentials.mjs",
    "production:full-commerce:preflight": "node deploy/direct-ubuntu/preflight-full-commerce.mjs",
    "production:origin:preflight": "node deploy/direct-ubuntu/preflight-origin.mjs",
    "production:sidecar:verify": "node deploy/direct-ubuntu/verify-sidecar.mjs",
    "production:nginx:verify": "node deploy/direct-ubuntu/verify-nginx-config.mjs",
    "production:rollback:verify": "node deploy/direct-ubuntu/verify-rollback.mjs",
    "production:probe-systemd:verify": "node deploy/direct-ubuntu/verify-paired-probe-systemd.mjs",
    "production:env:verify": "node scripts/verify-production-env.mjs",
    "production:readiness:record": "node scripts/record-inquiry-readiness.mjs",
    "production:app-session:record": "node scripts/record-inquiry-app-session.mjs",
    "production:aws-routing:capture": "node deploy/aws-ubuntu/verify-routing.mjs capture",
    "production:aws-routing:verify": "node deploy/aws-ubuntu/verify-routing.mjs verify",
    "production:aws-host:preflight": "node deploy/aws-ubuntu/preflight-host.mjs",
    "production:aws-sidecar:verify": "node deploy/aws-ubuntu/verify-sidecar.mjs",
    "production:admin-routing:verify": "node deploy/kubernetes/verify-admin-routing.mjs",
    "production:admin-env:verify": "node scripts/verify-production-env.mjs --admin-only"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "alipay-sdk": "^4.14.0",
    "fastify": "^5.11.3",
    "fastify-raw-body": "^6.0.1",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
