{
  "name": "doujoy-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "server": "node --experimental-strip-types server/src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "verify": "npm test && npm run check && npm --prefix mobile run typecheck && npm run preflight"
  }
}
