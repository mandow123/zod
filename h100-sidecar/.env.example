# Copy to /etc/kai-h100-sidecar/sidecar.env and chmod 600. Never commit real values.
SIDECAR_HOST=10.0.0.10
SIDECAR_PORT=9443
SIDECAR_PUBLIC_ORIGIN=https://h100-sidecar.internal:9443
# Trusted pin. It must exactly match backendBaseUrl inside the one-time claim JSON.
SIDECAR_BACKEND_BASE_URL=
SIDECAR_ALLOWED_BACKEND_IPS=10.0.1.20
SIDECAR_TLS_CERT_FILE=/etc/kai-h100-sidecar/tls/fullchain.pem
SIDECAR_TLS_KEY_FILE=/etc/kai-h100-sidecar/tls/privkey.pem
SIDECAR_STATE_DIRECTORY=/var/lib/kai-h100-sidecar
SIDECAR_WORKSPACE_DIRECTORY=/srv/kai-h100-workspaces
SIDECAR_WORKSPACE_QUOTA_MOUNT=/srv
SIDECAR_WORKSPACE_QUOTA_SIZE=250g
SIDECAR_HOST_DISK_RESERVE_SIZE=500g
SIDECAR_RESOURCE_POLICIES_FILE=/etc/kai-h100-sidecar/resource-policies.json
# Generate separate values with: openssl rand -hex 32
SIDECAR_PROVIDER_TOKEN=
# Optional during a controlled token rotation only.
# SIDECAR_PROVIDER_TOKEN_PREVIOUS=
# Keep this stable across restarts while any access session is live. Never reuse the provider token.
SIDECAR_TICKET_SECRET=
SIDECAR_WORKLOAD_IMAGE=registry.example.com/kai/h100-workload@sha256:replace-with-reviewed-digest
SIDECAR_EXPECTED_GPU_COUNT=8
SIDECAR_DEFAULT_GPU_COUNT=1
SIDECAR_SSH_PUBLIC_HOST=h100.example.com
SIDECAR_SSH_BIND_HOST=10.0.0.10
SIDECAR_SSH_PORT_START=22000
SIDECAR_SSH_PORT_END=22099
SIDECAR_ACCESS_TTL_SECONDS=300
SIDECAR_MAX_ACTIVE_SESSIONS_GLOBAL=64
SIDECAR_STATE_MAX_BYTES=1048576
SIDECAR_CONTAINER_MEMORY=240g
SIDECAR_CONTAINER_CPUS=24
SIDECAR_CONTAINER_STORAGE_SIZE=100g
SIDECAR_LOG_LEVEL=info
# Node enrollment is imported interactively with: sudo kai-h100-sidecar-enroll
SIDECAR_NODE_AGENT_VERSION=1.0.0
SIDECAR_NODE_HEARTBEAT_INTERVAL_SECONDS=30
SIDECAR_BACKEND_REQUEST_TIMEOUT_MS=10000
SIDECAR_NODE_RETRY_MIN_MS=1000
SIDECAR_NODE_RETRY_MAX_MS=30000
# Optional private CA bundle for the backend HTTPS endpoint. Public PKI normally needs no override.
# SIDECAR_BACKEND_CA_FILE=/etc/kai-h100-sidecar/backend-ca.pem
