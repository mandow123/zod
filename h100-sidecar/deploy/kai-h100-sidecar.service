[Unit]
Description=KAI Cloud H100 lease sidecar
After=docker.service network-online.target time-sync.target
Requires=docker.service
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/kai-h100-sidecar/sidecar.env
WorkingDirectory=/opt/kai-h100-sidecar
ExecStartPre=/usr/bin/node /opt/kai-h100-sidecar/scripts/connect-node-once.mjs
ExecStartPre=/usr/bin/node /opt/kai-h100-sidecar/scripts/preflight.mjs
ExecStart=/usr/bin/node /opt/kai-h100-sidecar/src/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/kai-h100-sidecar /srv/kai-h100-workspaces
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
