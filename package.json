{
  "name": "cloudpay-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.12",
    "expo-auth-session": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant directCnDebug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "npm run typecheck:mobile",
    "typecheck:mobile": "tsc -p tsconfig.json --noEmit",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "contract:verify": "node scripts/verify-mobile-backend-contract.mjs",
    "audit:product": "node scripts/verify-product-manager-audit.mjs",
    "setup:git-hooks": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prebuild:android": "expo prebuild --platform android",
    "build:preview": "node scripts/run-android-gradle.mjs assembleDirectCnDebug",
    "build:apk": "node scripts/build-android-release.mjs apk",
    "build:aab": "node scripts/build-android-release.mjs aab",
    "build:apk:direct": "node scripts/build-android-release.mjs apk --channel=direct-cn",
    "build:aab:play": "node scripts/build-android-release.mjs aab --channel=google-play",
    "release:key": "node scripts/generate-upload-key.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:smoke:android": "node scripts/android-device-smoke.mjs",
    "test:android:store-provider": "node scripts/android-device-smoke.mjs --store --install --provider artifacts/test/KAI-CloudPay-1.0.0-1-google-play-local-e2e.apk",
    "preview:android:provider": "node scripts/android-device-smoke.mjs --local-e2e --install --provider --replace-incompatible"
  },
  "private": true
}
